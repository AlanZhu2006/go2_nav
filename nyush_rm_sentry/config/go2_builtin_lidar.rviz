Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 100
      Name: Go2RobotOdom
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /utlidar/robot_odom
      Value: true
    - Alpha: 0.8
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 1
      Enabled: true
      Name: CloudBase
      Position Transformer: XYZ
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /utlidar/cloud_base
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.5
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 5
      Enabled: true
      Name: CloudDeskewed
      Position Transformer: XYZ
      Size (Pixels): 1
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /utlidar/cloud_deskewed
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.8
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Color: 80; 180; 255
      Decay Time: 0
      Enabled: true
      Name: USlamCloudMap
      Position Transformer: XYZ
      Size (Pixels): 1
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /uslam/cloud_map
      Use Fixed Frame: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 20; 20
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.8
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
